# Copy to .env for local dev. On Railway, set these as service variables.

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# Protects /api/test/* and the asset upload route. Change it in production.
ADMIN_CODE=otyadmin

# Where the SQLite file and uploaded art live. On Railway point this at the volume mount.
# DATA_DIR=/data
